# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Local PostgreSQL. Use letters and numbers only in the password.
DATABASE_URL=postgresql+psycopg://myspott_user:YOUR_PASSWORD@localhost:5432/myspott_dev
# Tests use a separate database because they erase its data.
TEST_DATABASE_URL=postgresql+psycopg://myspott_user:YOUR_PASSWORD@localhost:5432/myspott_test

# Site address used in emailed links (must start with https:// in production).
APP_BASE_URL=http://127.0.0.1:5000

# Email. "console" prints emails in the Terminal (development). Use "smtp" to really send.
MAIL_BACKEND=console
MAIL_FROM=MySpott <no-reply@myspott.local>
# Only needed when MAIL_BACKEND=smtp:
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=true