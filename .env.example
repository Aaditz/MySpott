# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Local PostgreSQL. Use letters and numbers only in the password.
DATABASE_URL=postgresql+psycopg://myspott_user:YOUR_PASSWORD@localhost:5432/myspott_dev
# Tests use a separate database because they erase its data.
TEST_DATABASE_URL=postgresql+psycopg://myspott_user:YOUR_PASSWORD@localhost:5432/myspott_test